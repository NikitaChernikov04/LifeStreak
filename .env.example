# Used by docker-compose.yml for variable substitution.
# Copy to .env and fill in real values before running `docker compose up`.

JWT_SECRET=change-me-to-a-long-random-string
TELEGRAM_BOT_TOKEN=
TELEGRAM_SKIP_AUTH_VALIDATION=false
# Optional, for invite links: @username is looked up via getMe when empty,
# the short name is the one given to /newapp in BotFather.
TELEGRAM_BOT_USERNAME=
TELEGRAM_MINIAPP_SHORT_NAME=
# Bot messages: the webhook and the evening digest stay closed while empty.
TELEGRAM_WEBHOOK_SECRET=
CRON_SECRET=
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000/api/v1

# Seed the demo user and its sample streaks alongside the catalogues.
SEED_DEMO=false
