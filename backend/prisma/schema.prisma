// LifeStreak — Prisma schema (Turso / libSQL)
// "Стань человеком, которым всегда хотел быть."
//
// Runs on Turso (SQLite-compatible, edge-hosted). Prisma has no native enum
// support on SQLite, so status/reason/key fields below are plain String
// columns validated against the union types in src/common/enums.ts.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────
// USERS
// ──────────────────────────────────────────────────────────────

model User {
  id           String  @id @default(cuid())
  telegramId   String  @unique // Telegram user id, stored as string (safe across SQLite/libSQL drivers)
  username     String?
  firstName    String
  lastName     String?
  avatarUrl    String?
  languageCode String?

  level     Int @default(1)
  xp        Int @default(0)
  hearts    Int @default(3) // starting hearts, max 5
  maxHearts Int @default(5)

  // Whether the account turns up in search. Consent to be read lives in
  // accepting a friend request, so this only decides how findable someone is
  // before that conversation starts.
  isDiscoverable Boolean @default(true)

  // The user's own switch for messages from the bot. `botBlocked` is not a
  // setting but an observation: Telegram refuses to deliver to someone who
  // never pressed Start or who blocked the bot, and both look identical from
  // here — a 403. Recording it stops us from asking again every evening.
  dmEnabled  Boolean @default(true)
  botBlocked Boolean @default(false)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastSeenAt DateTime @default(now())

  streaks         Streak[]
  checkins        DailyCheckin[]
  achievements    UserAchievement[]
  heartLedger     HeartTransaction[]
  dailyChallenges DailyChallenge[]
  notifications   Notification[]
  statistics      Statistics?

  invitesSent Invite[] @relation("Inviter")
  invitesUsed Invite[] @relation("Invitee")

  friendshipsSent     Friendship[]       @relation("Requester")
  friendshipsReceived Friendship[]       @relation("Addressee")
  reactions           Reaction[]
  goalsOwned          GroupGoal[]        @relation("GoalOwner")
  goalMemberships     GroupGoalMember[]
  goalCheckins        GroupGoalCheckin[]
  circleMemberships   ChatCircleMember[]

  @@index([telegramId])
  @@map("users")
}

// ──────────────────────────────────────────────────────────────
// STREAKS
// ──────────────────────────────────────────────────────────────
// status: "ACTIVE" | "BROKEN" | "ARCHIVED" — see StreakStatus in common/enums.ts

model Streak {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  icon        String // emoji
  color       String // hex, for card theming
  templateKey String? // e.g. "reading", "sport", "coding" — null if custom

  currentCount  Int @default(0)
  longestCount  Int @default(0)
  // Days the user had already accumulated elsewhere before joining. Counted in
  // currentCount, but kept separately so the record can show them as carried
  // over rather than observed here.
  importedCount Int @default(0)
  nextGoal      Int @default(7) // next milestone shown on the card

  status           String    @default("ACTIVE")
  lastCheckinAt    DateTime?
  freezesUsedTotal Int       @default(0)

  // Per-streak consent. Approving a follower opens the profile, not every
  // habit in it: "не курю" and "спорт" do not deserve the same audience.
  // Off by default — a streak becomes visible only when its owner says so.
  isShared Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checkins DailyCheckin[]

  @@index([userId, status])
  @@map("streaks")
}

// ──────────────────────────────────────────────────────────────
// DAILY CHECKINS
// ──────────────────────────────────────────────────────────────

model DailyCheckin {
  id       String @id @default(cuid())
  streakId String
  streak   Streak @relation(fields: [streakId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Calendar date (UTC midnight) the checkin counts for — one per streak per day.
  date      DateTime
  usedHeart Boolean  @default(false) // true if this checkin recovered a missed day
  xpEarned  Int      @default(20)

  createdAt DateTime @default(now())

  reactions Reaction[]

  @@unique([streakId, date])
  @@index([userId, date])
  @@map("daily_checkins")
}

// ──────────────────────────────────────────────────────────────
// CHALLENGES
// ──────────────────────────────────────────────────────────────
// rewardType: "XP" | "HEART" — see ChallengeReward in common/enums.ts

model ChallengeTemplate {
  id          String  @id @default(cuid())
  title       String
  description String
  icon        String
  xpReward    Int     @default(40)
  rewardType  String  @default("XP")
  isActive    Boolean @default(true)

  dailyChallenges DailyChallenge[]

  @@map("challenge_templates")
}

// status: "PENDING" | "COMPLETED" | "EXPIRED" — see DailyChallengeStatus in common/enums.ts

model DailyChallenge {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId String
  template   ChallengeTemplate @relation(fields: [templateId], references: [id])

  date        DateTime
  status      String    @default("PENDING")
  completedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, status])
  @@map("daily_challenges")
}

// ──────────────────────────────────────────────────────────────
// ACHIEVEMENTS
// ──────────────────────────────────────────────────────────────
// key: see AchievementKey in common/enums.ts

model AchievementDefinition {
  id          String @id @default(cuid())
  key         String @unique
  title       String
  description String
  icon        String
  xpReward    Int    @default(100)

  unlocks UserAchievement[]

  @@map("achievement_definitions")
}

model UserAchievement {
  id           String                @id @default(cuid())
  userId       String
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  definitionId String
  definition   AchievementDefinition @relation(fields: [definitionId], references: [id])

  unlockedAt DateTime @default(now())

  @@unique([userId, definitionId])
  @@map("user_achievements")
}

// ──────────────────────────────────────────────────────────────
// HEARTS LEDGER
// ──────────────────────────────────────────────────────────────
// reason: see HeartReason in common/enums.ts

model HeartTransaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount    Int // positive = earned, negative = spent
  reason    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("heart_transactions")
}

// ──────────────────────────────────────────────────────────────
// STATISTICS (denormalized per-user rollup for fast profile reads)
// ──────────────────────────────────────────────────────────────

model Statistics {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  totalXp            Int @default(0)
  totalCheckins      Int @default(0)
  activeStreaksCount Int @default(0)
  longestStreakEver  Int @default(0)
  perfectDaysCount   Int @default(0) // days where every active streak was checked in

  updatedAt DateTime @updatedAt

  @@map("statistics")
}

// ──────────────────────────────────────────────────────────────
// INVITES
// ──────────────────────────────────────────────────────────────
// status: "PENDING" | "ACCEPTED" — see InviteStatus in common/enums.ts

model Invite {
  id   String @id @default(cuid())
  code String @unique

  inviterId String
  inviter   User   @relation("Inviter", fields: [inviterId], references: [id], onDelete: Cascade)

  inviteeId String?
  invitee   User?   @relation("Invitee", fields: [inviteeId], references: [id], onDelete: SetNull)

  status     String    @default("PENDING")
  createdAt  DateTime  @default(now())
  acceptedAt DateTime?

  @@index([inviterId])
  @@map("invites")
}

// ──────────────────────────────────────────────────────────────
// SOCIAL GRAPH
// ──────────────────────────────────────────────────────────────
// Friendship is mutual and always asked for: one side requests, the other
// answers, and once accepted the row means the same thing read from either
// end. status: "PENDING" | "ACCEPTED" — see FriendshipStatus in
// common/enums.ts.
//
// requester/addressee record who asked, not who owns the relation — they are
// only consulted while the request is pending. One row per pair: the unique
// index cannot express that on its own (it would still allow A→B and B→A), so
// the service checks both directions before writing, and treats a crossing
// request as agreement rather than a second row.
//
// Declining deletes the row instead of storing a refusal, so the same request
// can be made again later. That is deliberately not blocking.

model Friendship {
  id String @id @default(cuid())

  requesterId String
  requester   User   @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)

  addresseeId String
  addressee   User   @relation("Addressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
  @@map("friendships")
}

// ──────────────────────────────────────────────────────────────
// GROUP GOALS
// ──────────────────────────────────────────────────────────────
// Something several friends do at once, in one of two shapes.
//
// TOGETHER — they hold it together. The day counts for the group only once
// every joined member has marked it, so `currentCount` is a property of the
// group, not a sum of anyone's effort. State is derived from
// `lastCountedDate` rather than tracked by a scheduler: with no cron in
// production, a goal that "should have broken" overnight must still read as
// broken the next time anyone opens it.
//
// VERSUS — they compete. Everyone keeps their own days, and those days are
// scored in fixed sprints rather than one running total. A total is
// unwinnable once a gap opens, which makes the person behind a spectator for
// the rest of the distance; a sprint restarts, so being four sprints down is
// a thing you can still answer. Nothing here is credited to the group, so
// `currentCount` and `lastCountedDate` stay untouched.
//
// status: "ACTIVE" | "COMPLETED" | "ABANDONED" — see GroupGoalStatus.

model GroupGoal {
  id String @id @default(cuid())

  title String
  icon  String
  color String

  /// "TOGETHER" | "VERSUS" — see GoalMode.
  mode String @default("TOGETHER")

  targetDays   Int // the finish line: reaching it completes the goal
  currentCount Int @default(0)

  // VERSUS only. The sprint length; the number of sprints is
  // `targetDays / sprintDays`, which is why a competition's length is chosen
  // as a count of sprints and can never leave a remainder.
  sprintDays Int @default(5)
  // UTC midnight the first sprint opened. A competition needs a fixed
  // calendar — which days belong to which sprint has to be the same answer
  // for both sides. TOGETHER has no such need and leaves this null.
  startDate  DateTime?
  // Index of the last sprint whose result has been announced, -1 before the
  // first. Sprints are settled lazily on read like everything else here, and
  // this is what keeps that from announcing the same sprint twice.
  settledSprint Int @default(-1)

  status          String    @default("ACTIVE")
  // Last UTC date credited to the whole group. Null until the first full day.
  lastCountedDate DateTime?

  ownerId String
  owner   User   @relation("GoalOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  members  GroupGoalMember[]
  checkins GroupGoalCheckin[]

  @@index([ownerId, status])
  @@map("group_goals")
}

// status: "INVITED" | "JOINED" — an invitation is not participation, and a
// goal never waits on somebody who has not agreed to hold it.

model GroupGoalMember {
  id String @id @default(cuid())

  goalId String
  goal   GroupGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status   String    @default("INVITED")
  joinedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([goalId, userId])
  @@index([userId, status])
  @@map("group_goal_members")
}

model GroupGoalCheckin {
  id String @id @default(cuid())

  goalId String
  goal   GroupGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date      DateTime // UTC midnight of the day it counts for
  usedHeart Boolean  @default(false) // closed a missed day rather than today

  // Optional evidence for the day, readable only by the people in this goal.
  //
  // It is testimony, not a gate: nobody approves it, it changes no score, and
  // a day without it counts exactly the same. Any approval flow would put a
  // blocking step on the one action the whole product depends on being
  // instant, and would still not stop a determined faker. What stops one is
  // that the person who knows whether you are lying is reading it.
  proofNote String?
  proofUrl  String?

  createdAt DateTime @default(now())

  @@unique([goalId, userId, date])
  @@index([goalId, date])
  @@map("group_goal_checkins")
}

// ──────────────────────────────────────────────────────────────
// CHAT CIRCLES
// ──────────────────────────────────────────────────────────────
// A Telegram group the bot has been added to, and the people in it who asked
// to be counted. Every other tracker has to build the circle of friends before
// it can use one; a group chat is a circle that already exists, with the
// membership, the names and the habit of reading it every day already in place.
//
// What goes out there is deliberately thin: how many of each member's streaks
// are marked today, and nothing about which ones. Per-streak sharing (see
// Streak.isShared) is consent to be read by *friends*, and a group chat is not
// the same audience — reusing that flag here would leak one into the other.
// Joining the circle is the consent, and it is withdrawn with /leave.

model ChatCircle {
  id String @id @default(cuid())

  // Telegram's chat id. Negative for groups, which is also why it can never
  // collide with the positive user ids stored on User.telegramId.
  telegramChatId String  @unique
  title          String?

  // Removal from the chat is not deletion: the same group can add the bot back
  // and everyone who joined is still there, which is kinder than making four
  // people re-register because someone tidied up the member list.
  isActive Boolean @default(true)

  // Last UTC date an evening line went out. One per chat per day, whatever the
  // scheduler does — a group tolerates far less repetition than a private chat.
  lastDigestDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members ChatCircleMember[]

  @@index([isActive])
  @@map("chat_circles")
}

model ChatCircleMember {
  id String @id @default(cuid())

  circleId String
  circle   ChatCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([circleId, userId])
  @@index([userId])
  @@map("chat_circle_members")
}

// ──────────────────────────────────────────────────────────────
// REACTIONS
// ──────────────────────────────────────────────────────────────
// key: see ReactionKey in common/enums.ts. One reaction per person per
// checkin: reacting again switches it rather than stacking, which keeps the
// counter under a checkin readable at a glance.

model Reaction {
  id String @id @default(cuid())

  checkinId String
  checkin   DailyCheckin @relation(fields: [checkinId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  key       String
  createdAt DateTime @default(now())

  @@unique([checkinId, userId])
  @@index([checkinId])
  @@map("reactions")
}

// ──────────────────────────────────────────────────────────────
// NOTIFICATIONS
// ──────────────────────────────────────────────────────────────
// type: see NotificationType in common/enums.ts

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    String
  title   String
  body    String
  payload String? // JSON-encoded — SQLite has no native Json type, serialized manually
  isRead  Boolean @default(false)

  // When this went out as a Telegram message. Null covers both "not worth a
  // message" and "could not be delivered", which for throttling are the same
  // thing: neither one reached the user, so neither should silence the next.
  deliveredAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}
