// LifeStreak — Prisma schema (Turso / libSQL)
// "Стань человеком, которым всегда хотел быть."
//
// Runs on Turso (SQLite-compatible, edge-hosted). Prisma has no native enum
// support on SQLite, so status/reason/key fields below are plain String
// columns validated against the union types in src/common/enums.ts.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────
// USERS
// ──────────────────────────────────────────────────────────────

model User {
  id         String   @id @default(cuid())
  telegramId String   @unique // Telegram user id, stored as string (safe across SQLite/libSQL drivers)
  username   String?
  firstName  String
  lastName   String?
  avatarUrl  String?
  languageCode String?

  level      Int      @default(1)
  xp         Int      @default(0)
  hearts     Int      @default(3) // starting hearts, max 5
  maxHearts  Int      @default(5)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastSeenAt DateTime @default(now())

  streaks        Streak[]
  checkins       DailyCheckin[]
  achievements   UserAchievement[]
  heartLedger    HeartTransaction[]
  dailyChallenges DailyChallenge[]
  notifications  Notification[]
  statistics     Statistics?

  invitesSent    Invite[] @relation("Inviter")
  invitesUsed    Invite[] @relation("Invitee")

  @@index([telegramId])
  @@map("users")
}

// ──────────────────────────────────────────────────────────────
// STREAKS
// ──────────────────────────────────────────────────────────────
// status: "ACTIVE" | "BROKEN" | "ARCHIVED" — see StreakStatus in common/enums.ts

model Streak {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  title      String
  icon       String // emoji
  color      String // hex, for card theming
  templateKey String? // e.g. "reading", "sport", "coding" — null if custom

  currentCount   Int      @default(0)
  longestCount   Int      @default(0)
  // Days the user had already accumulated elsewhere before joining. Counted in
  // currentCount, but kept separately so the record can show them as carried
  // over rather than observed here.
  importedCount  Int      @default(0)
  nextGoal       Int      @default(7) // next milestone shown on the card

  status         String   @default("ACTIVE")
  lastCheckinAt  DateTime?
  freezesUsedTotal Int    @default(0)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  checkins   DailyCheckin[]

  @@index([userId, status])
  @@map("streaks")
}

// ──────────────────────────────────────────────────────────────
// DAILY CHECKINS
// ──────────────────────────────────────────────────────────────

model DailyCheckin {
  id         String   @id @default(cuid())
  streakId   String
  streak     Streak   @relation(fields: [streakId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Calendar date (UTC midnight) the checkin counts for — one per streak per day.
  date       DateTime
  usedHeart  Boolean  @default(false) // true if this checkin recovered a missed day
  xpEarned   Int      @default(20)

  createdAt  DateTime @default(now())

  @@unique([streakId, date])
  @@index([userId, date])
  @@map("daily_checkins")
}

// ──────────────────────────────────────────────────────────────
// CHALLENGES
// ──────────────────────────────────────────────────────────────
// rewardType: "XP" | "HEART" — see ChallengeReward in common/enums.ts

model ChallengeTemplate {
  id           String   @id @default(cuid())
  title        String
  description  String
  icon         String
  xpReward     Int      @default(40)
  rewardType   String   @default("XP")
  isActive     Boolean  @default(true)

  dailyChallenges DailyChallenge[]

  @@map("challenge_templates")
}

// status: "PENDING" | "COMPLETED" | "EXPIRED" — see DailyChallengeStatus in common/enums.ts

model DailyChallenge {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId   String
  template     ChallengeTemplate @relation(fields: [templateId], references: [id])

  date         DateTime
  status       String   @default("PENDING")
  completedAt  DateTime?

  createdAt    DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, status])
  @@map("daily_challenges")
}

// ──────────────────────────────────────────────────────────────
// ACHIEVEMENTS
// ──────────────────────────────────────────────────────────────
// key: see AchievementKey in common/enums.ts

model AchievementDefinition {
  id          String   @id @default(cuid())
  key         String   @unique
  title       String
  description String
  icon        String
  xpReward    Int      @default(100)

  unlocks     UserAchievement[]

  @@map("achievement_definitions")
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  definitionId  String
  definition    AchievementDefinition @relation(fields: [definitionId], references: [id])

  unlockedAt    DateTime @default(now())

  @@unique([userId, definitionId])
  @@map("user_achievements")
}

// ──────────────────────────────────────────────────────────────
// HEARTS LEDGER
// ──────────────────────────────────────────────────────────────
// reason: see HeartReason in common/enums.ts

model HeartTransaction {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount    Int // positive = earned, negative = spent
  reason    String
  createdAt DateTime    @default(now())

  @@index([userId, createdAt])
  @@map("heart_transactions")
}

// ──────────────────────────────────────────────────────────────
// STATISTICS (denormalized per-user rollup for fast profile reads)
// ──────────────────────────────────────────────────────────────

model Statistics {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  totalXp             Int      @default(0)
  totalCheckins       Int      @default(0)
  activeStreaksCount  Int      @default(0)
  longestStreakEver   Int      @default(0)
  perfectDaysCount     Int     @default(0) // days where every active streak was checked in

  updatedAt           DateTime @updatedAt

  @@map("statistics")
}

// ──────────────────────────────────────────────────────────────
// INVITES
// ──────────────────────────────────────────────────────────────
// status: "PENDING" | "ACCEPTED" — see InviteStatus in common/enums.ts

model Invite {
  id          String   @id @default(cuid())
  code        String   @unique

  inviterId   String
  inviter     User     @relation("Inviter", fields: [inviterId], references: [id], onDelete: Cascade)

  inviteeId   String?
  invitee     User?    @relation("Invitee", fields: [inviteeId], references: [id], onDelete: SetNull)

  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  acceptedAt  DateTime?

  @@index([inviterId])
  @@map("invites")
}

// ──────────────────────────────────────────────────────────────
// NOTIFICATIONS
// ──────────────────────────────────────────────────────────────
// type: see NotificationType in common/enums.ts

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String
  title     String
  body      String
  payload   String? // JSON-encoded — SQLite has no native Json type, serialized manually
  isRead    Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}
