NODE_ENV=development
PORT=3000

# SQLite. A relative file: URL is resolved against backend/prisma/, so the
# Prisma CLI and the running app always agree on one physical file.
# In production this is an absolute path on the mounted volume, e.g.
#   DATABASE_URL=file:/data/lifestreak.db
# To use Turso instead, point it at the remote database and set the token:
#   DATABASE_URL=libsql://<db>-<org>.turso.io
#   TURSO_AUTH_TOKEN=<token>
DATABASE_URL="file:./dev.db"

JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="30d"

TELEGRAM_BOT_TOKEN=""
# "true" only for local development in a plain browser, without a real bot.
# MUST be "false" in production — it disables initData signature checking.
TELEGRAM_SKIP_AUTH_VALIDATION="true"

CORS_ORIGIN="http://localhost:5173"

# Include the demo user and sample streaks when running the seed.
SEED_DEMO="true"
