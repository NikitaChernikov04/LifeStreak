NODE_ENV=development
PORT=3000

# PostgreSQL (Supabase). Two URLs for the same database, and they are not
# interchangeable — see the comment in prisma/schema.prisma.
#
# The app: the transaction pooler on :6543. `connection_limit=1` is not a
# throttle but the point — each serverless invocation gets one connection and
# gives it back at the end of the transaction. `connect_timeout=15` because
# the pooler's handshake measured 2–3.5s and Prisma's default gives up at 5.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&connect_timeout=15"
# Migrations, seeding and one-off scripts: a session connection on :5432. DDL
# and advisory locks do not survive a transaction pooler. `connection_limit=1`
# because Prisma otherwise opens one connection per CPU (thirteen here) against
# a session pooler that neither needs nor allows that many, and the pool times
# out with P2024 before a single query runs.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?connect_timeout=15&connection_limit=1&pool_timeout=30"

JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="30d"

TELEGRAM_BOT_TOKEN=""
# "true" only for local development in a plain browser, without a real bot.
# MUST be "false" in production — it disables initData signature checking.
TELEGRAM_SKIP_AUTH_VALIDATION="true"

# Both optional, and only used to build invite links.
# The @username is looked up via getMe when left empty.
TELEGRAM_BOT_USERNAME=""
# Short name given to /newapp in BotFather. Set it unless the bot has a
# "main" Mini App configured — without it invite links open the bot, not the app.
TELEGRAM_MINIAPP_SHORT_NAME=""

# Messages from the bot. Both endpoints they guard stay closed while the value
# is empty, so a forgotten variable switches a feature off rather than opening
# it to anyone who knows the path.
TELEGRAM_WEBHOOK_SECRET=""
CRON_SECRET=""
# Points the bot at a stub instead of api.telegram.org. Tests only.
TELEGRAM_API_BASE=""

CORS_ORIGIN="http://localhost:5173"

# Include the demo user and sample streaks when running the seed.
SEED_DEMO="true"
